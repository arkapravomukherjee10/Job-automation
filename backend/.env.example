APP_MODE=production
DATABASE_URL=postgresql+psycopg://USER@HOST:5432/postgres?sslmode=require
DB_PASSWORD=REPLACE_WITH_RAW_DATABASE_PASSWORD
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
FRONTEND_ORIGINS=https://YOUR_SITE.pages.dev
